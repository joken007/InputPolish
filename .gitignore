# 构建产物（保留可直接运行的 exe，方便不想编译的人）
dist/*
!dist/InputPolish.exe
*.pdb
*.obj

# 测试脚手架编译结果（源码 tests/*.cs 保留）
tests/*.exe
tests/out/

# 扩展与本机配对的本机文件：含连接码，绝不入库
# 注意文件名不能以下划线开头：Chrome 扩展目录里 "_" 开头的文件会导致「无法加载清单」
ext/ip-pair.json
ext/_pair.json

# 本地临时
*.log
*.tmp
__pycache__/
*.pyc

# 编辑器
.vs/
.vscode/
*.user
*.suo
